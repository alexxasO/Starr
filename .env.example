COMPOSE_PROFILES="blackhole"

DATA_PATH=/path/to/data
APPDATA_PATH=/path/to/appdata
TRANSCODE_PATH=/path/to/transcode
PUID=1000
PGID=1000
TZ=Europe/Paris
UMASK=002
DOMAIN=yourdomain.com
ADMIN_TOKEN=StrongAdminTokenHere

DISCORD_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

SCRIPTS_PATH=/path/to/scripts

# Tokens
PLEX_URL="yourplexurl.com"
PLEX_TOKEN="PlecTokenHere"

JELLYFIN_URL="yourjellyfinurl.com"
JELLYFIN_TOKEN="jellytoken"
JELLYFIN_SPOTLIGHT_TOKEN="YOUR_JELLYFIN_SPOTLIGHT_TOKEN"

JELLYSTAT_URL="yourjellystaturl.com"
JELLYSTAT_TOKEN="jellystattoken"
JELLYSTAT_POSTGRES_PASSWORD=changeme
JELLYSTAT_JWT_SECRET=changeme-jellystat-jwt

MAXMIND_LICENSE_KEY="MaxmindLicenseKeyHere"

GAMEYFIN_API_TOKEN="GameyfinApiTokenHere"
GAMEYFIN_APP_URL="yourgameyfinurl.com"

# Tracearr
JWT_SECRET=
COOKIE_SECRET=

# Tailscale / Pi-hole
TS_AUTHKEY=tskey-auth-YOUR_TAILSCALE_AUTHKEY
PIHOLE_WEBPASSWORD=changeme

# ProtonVPN (Gluetun)
OPENVPN_USER=YOUR_OPENVPN_USER
OPENVPN_PASSWORD=YOUR_OPENVPN_PASSWORD

# Real-Debrid (also set in zurg/config.yml — copy from zurg/config.yml.example)
REAL_DEBRID_TOKEN=YOUR_REAL_DEBRID_TOKEN

# Arr / indexers scripts
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY
PASSKEY_SHAREWOOD=YOUR_SHAREWOOD_PASSKEY
SONARR_API_KEY=YOUR_SONARR_API_KEY
DOWNLOAD_CLIENT_USERNAME=admin
DOWNLOAD_CLIENT_PASSWORD=changeme

# Varken
VRKN_TAUTULLI_1_APIKEY=YOUR_TAUTULLI_API_KEY
VRKN_SONARR_1_APIKEY=YOUR_SONARR_API_KEY
VRKN_RADARR_1_APIKEY=YOUR_RADARR_API_KEY

# Homarr (do not rotate without Homarr migration)
SECRET_ENCRYPTION_KEY=YOUR_HOMARR_SECRET_ENCRYPTION_KEY

# Meilisearch
MEILI_MASTER_KEY=YOUR_MEILI_MASTER_KEY

# TubeArchivist
TA_USERNAME=admin
TA_PASSWORD=changeme
ELASTIC_PASSWORD=changeme

# Grafana
GF_SECURITY_ADMIN_PASSWORD=changeme
